// ===========================================================
// Sistema de Gestión de Personal - UGEL Talara
// Prisma Schema - Fase 0
// ===========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------
// ENUMS
// ---------------------------

enum Rol {
  VIGILANTE
  ESPECIALISTA
  JEFE
  DIRECTORA
  RRHH
  ADMIN
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum TipoTiempo {
  DIAS
  HORAS
}

enum EstadoPapeleta {
  PENDIENTE
  EN_REVISION
  OBSERVADO
  APROBADO
  RECHAZADO
  CANCELADO
  ANULADO
  ANULACION_SOLICITADA
}

// ---------------------------
// MODELOS
// ---------------------------

model Usuario {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String
  rol                 Rol
  activo              Boolean   @default(true)
  cambioPassword      Boolean   @default(true)
  // H-07: versión de los tokens de sesión emitidos para el usuario. Se
  // incrementa en cada cambio de contraseña para invalidar los JWT previos.
  tokenVersion        Int       @default(0)
  nombres             String
  apellidos           String
  foto                String?
  fechaCreacion       DateTime  @default(now())

  // ── Bloque A: jerarquía, autorización y delegación ──────────
  // Tratamiento formal con el que se firma/nombra al usuario en los
  // documentos oficiales (ej. "Lic.", "Ing.", "Mg.", "Dr.").
  tituloFormal        String?
  // Marca al usuario como ausente/no disponible: no puede figurar como
  // aprobador vigente hasta que regrese o exista una delegación activa.
  noDisponible        Boolean   @default(false)

  // Delegaciones de aprobación (quien delega y quien recibe la delegación)
  delegacionesComo     Delegacion[] @relation("DelegacionesTitular")
  delegacionesRecibidas Delegacion[] @relation("DelegacionesEncargado")
  delegacionesCreadas   Delegacion[] @relation("DelegacionesCreadas")

  // Jefatura a la que pertenece el usuario
  jefaturaId          Int?
  jefatura            Jefatura? @relation("UsuariosDeJefatura", fields: [jefaturaId], references: [id])

  // Jefatura que este usuario lidera (si su rol es JEFE), relación inversa 1:1
  jefaturaQueLidera   Jefatura? @relation("JefeDeJefatura")

  // Jefe inmediato (autorelación jerárquica)
  jefeId              Int?
  jefe                Usuario?  @relation("Subordinados", fields: [jefeId], references: [id])
  subordinados        Usuario[] @relation("Subordinados")

  // Usuario que lo reemplaza temporalmente cuando está ausente
  encargadoTemporalId Int?
  encargadoTemporal   Usuario?  @relation("EncargadoTemporal", fields: [encargadoTemporalId], references: [id])
  esEncargadoDe       Usuario[] @relation("EncargadoTemporal")

  // Relaciones con Papeleta
  papeletasCreadas    Papeleta[] @relation("PapeletasSolicitadas")
  papeletasAprobadas  Papeleta[] @relation("PapeletasAprobadas")
  papeletasAnuladas   Papeleta[] @relation("PapeletasAnuladasPorAdmin")
  papeletasReasignadas Papeleta[] @relation("PapeletaReasignadaPor")

  // Relación con Movimiento (asistencias)
  movimientos         Movimiento[]

  // B-03: movimientos de asistencia registrados y editados por este usuario
  // (trazabilidad de autoría de los cambios en asistencias).
  movimientosRegistrados Movimiento[] @relation("MovimientoRegistradoPor")
  movimientosEditados    Movimiento[] @relation("MovimientoEditadoPor")

  // Relaciones con Visita
  visitasRegistradas  Visita[] @relation("VisitasRegistradas")
  visitasRecibidas    Visita[] @relation("VisitasRecibidas")

  // Notificaciones del usuario
  notificaciones      Notificacion[]

  // Consultas de token de verificación realizadas por el usuario
  tokensConsultados   TokenVerificacion[] @relation("TokensConsultados")

  @@index([jefaturaId])
  @@index([jefeId])
  @@index([encargadoTemporalId])
}

model Jefatura {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?

  // Bloque A: las jefaturas oficiales (Dirección, Gestión Pedagógica,
  // Unidad de Administración, UPDI) se crean desde el seed y NO pueden
  // eliminarse; solo las jefaturas internas creadas por el Admin pueden
  // borrarse.
  esOficial   Boolean  @default(false)

  // Usuarios que pertenecen a esta jefatura (vía Usuario.jefaturaId)
  usuarios    Usuario[] @relation("UsuariosDeJefatura")

  // Usuario con rol JEFE asignado como cabeza de esta jefatura
  jefeId      Int?      @unique
  jefe        Usuario?  @relation("JefeDeJefatura", fields: [jefeId], references: [id])
}

model Movimiento {
  id         Int            @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  tipo       TipoMovimiento
  timestamp  DateTime
  bloqueado  Boolean        @default(false)

  // B-03: auditoría del movimiento. `registradoPor` es quien lo creó y
  // `editadoPor` quien lo modificó por última vez (null si nunca se editó).
  registradoPorId Int?
  registradoPor   Usuario? @relation("MovimientoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  editadoPorId Int?
  editadoPor   Usuario? @relation("MovimientoEditadoPor", fields: [editadoPorId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
}

model Papeleta {
  id                Int            @id @default(autoincrement())
  numero            String         @unique // ej: "0080-2026" (incluye año, único globalmente)

  solicitanteId     Int
  solicitante       Usuario        @relation("PapeletasSolicitadas", fields: [solicitanteId], references: [id])

  aprobadorId       Int?
  aprobador         Usuario?       @relation("PapeletasAprobadas", fields: [aprobadorId], references: [id])

  tipoTiempo        TipoTiempo
  fechaInicio       DateTime
  fechaFin          DateTime       // si es DIAS: fecha final. Si es HORAS: mismo día, con hora de retorno
  horaSalida        DateTime?      // solo para HORAS
  horaRetorno       DateTime?      // solo para HORAS

  motivo            String
  motivoOtros       String?

  estado            EstadoPapeleta @default(PENDIENTE)

  token             String?        @unique // 6 caracteres, generado al aprobar
  motivoRechazo     String?
  motivoAnulacion   String?

  anuladoPorAdmin   Boolean        @default(false)
  adminAnuladorId   Int?
  adminAnulador     Usuario?       @relation("PapeletasAnuladasPorAdmin", fields: [adminAnuladorId], references: [id])
  fechaAnulacion    DateTime?

  fechaRevision     DateTime?      // momento en que el aprobador abrió la revisión (EN_REVISION)

  // Bloque A: la papeleta quedó bloqueada porque no se pudo resolver un
  // aprobador válido (BLOQUEO_P1C / BLOQUEO_SIN_APROBADOR). Queda en
  // PENDIENTE sin aprobador y visible para el ADMIN, que debe intervenir.
  requiereAprobadorEspecial Boolean @default(false)

  // Desbloqueo administrativo: usuario que reasignó el aprobador. Cuando no
  // es null, el aprobador asignado queda habilitado aunque no sea el
  // aprobador natural de la jerarquía (ver esAprobadorVigente).
  reasignadoPorId Int?
  reasignadoPor   Usuario? @relation("PapeletaReasignadaPor", fields: [reasignadoPorId], references: [id], onDelete: SetNull)

  firmaExternaSvg   String?        // path/URL al archivo SVG almacenado en Supabase

  fechaCreacion     DateTime       @default(now())

  tokensVerificacion TokenVerificacion[]

  @@index([solicitanteId])
  @@index([aprobadorId])
  @@index([adminAnuladorId])
}

model Visita {
  id                   Int       @id @default(autoincrement())
  visitanteNombre      String
  visitanteDni         String

  trabajadorVisitadoId Int
  trabajadorVisitado   Usuario   @relation("VisitasRecibidas", fields: [trabajadorVisitadoId], references: [id])

  registradorId        Int
  registrador          Usuario   @relation("VisitasRegistradas", fields: [registradorId], references: [id])

  horaEntrada          DateTime
  horaSalida           DateTime?

  @@index([trabajadorVisitadoId])
  @@index([registradorId])
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  mensaje   String   @db.VarChar(500)
  leida     Boolean  @default(false)
  fecha     DateTime @default(now())

  @@index([usuarioId])
}

model TokenVerificacion {
  id                   Int       @id @default(autoincrement())
  token                String

  papeletaId           Int
  papeleta             Papeleta  @relation(fields: [papeletaId], references: [id])

  usuarioConsultanteId Int?
  consultante          Usuario?  @relation("TokensConsultados", fields: [usuarioConsultanteId], references: [id])

  fechaConsulta        DateTime  @default(now())

  @@index([papeletaId])
  @@index([usuarioConsultanteId])
}

// ---------------------------
// BLOQUE A: DELEGACIÓN DE APROBACIÓN
// ---------------------------

/// Delegación temporal de la facultad de aprobar papeletas de un titular
/// (JEFE o DIRECTORA) hacia un encargado activo. Mientras la delegación está
/// vigente (activo = true y fechaInicio <= ahora <= fechaFin), las papeletas
/// que le corresponderían al titular se enrutan automáticamente al encargado.
model Delegacion {
  id          Int      @id @default(autoincrement())

  titularId   Int
  titular     Usuario  @relation("DelegacionesTitular", fields: [titularId], references: [id])

  encargadoId Int
  encargado   Usuario  @relation("DelegacionesEncargado", fields: [encargadoId], references: [id])

  motivo       String?  @db.VarChar(1000)
  documentoRef String?  @db.VarChar(500)

  fechaInicio DateTime
  fechaFin    DateTime
  activo      Boolean  @default(true)

  creadoPorId Int?
  creadoPor   Usuario? @relation("DelegacionesCreadas", fields: [creadoPorId], references: [id])

  fechaCreacion DateTime @default(now())

  @@index([titularId])
  @@index([encargadoId])
  @@index([creadoPorId])
  @@index([activo, fechaInicio, fechaFin])
}
